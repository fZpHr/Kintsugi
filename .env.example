# Example environment file. Copy to .env and fill in your values:
#   cp .env.example .env
# The .env file is git-ignored; this example is safe to commit.

# --- AI analysis ---------------------------------------------------------
# Users can also enter their own key in the browser (Settings). The server's
# key below is the default when they don't. Set at least one of them.

# Google Gemini, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model tried first, then each fallback (comma separated) when it is
# overloaded (HTTP 503), out of quota (429) or retired (404).
# NOTE: the free tier has no quota at all on the Pro models.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Anthropic Claude, from https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible API: OpenAI, Mistral, OpenRouter, Groq, DeepSeek, a
# local Ollama or vLLM server, ...
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Which of the providers above the server uses: gemini, anthropic or openai.
# Defaults to the first one with a key.
# AI_PROVIDER=gemini

# Max output tokens (defaults to 65536 for Gemini, 32000 for Claude, and the
# API's own default for OpenAI-compatible APIs).
# AI_MAX_TOKENS=

# Max total characters of decompiler output sent to the model (defaults to
# 600000, ~170k tokens); the longest outputs are truncated to fit.
# AI_MAX_INPUT_CHARS=600000

# --- Public instance -----------------------------------------------------
# Keep these on for local use. On an instance other people can reach:
# - AI_ALLOW_CUSTOM_BASE_URL=0, or the server sends requests to any URL a
#   visitor enters as an OpenAI-compatible base URL;
# - HISTORY_ENABLED=0, or every visitor sees (and can delete) every binary.
# AI_ALLOW_BROWSER_KEYS=1
# AI_ALLOW_CUSTOM_BASE_URL=1
# HISTORY_ENABLED=1

# --- Django ----------------------------------------------------------------
# Set to 1 to enable debug mode locally.
DEBUG=0
